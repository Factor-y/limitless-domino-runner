{
  "openapi": "3.0.3",
  "info": {
    "title": "Domino Web Designer API",
    "version": "1.0.0",
    "description": "Read and write access to a local or remote HCL Domino environment, served by a program hosted in DominoRunner.\n\nAll access uses the Notes identity the runner was initialized with. Reading is always available; **writing (DXL import and signing) requires the server to be started with `--allow-write`** and returns 403 otherwise.\n\n**Why query parameters instead of path segments:** Domino file paths contain `/` and `\\\\` for subdirectories, which as path segments would require fragile double-encoding."
  },
  "servers": [
    {
      "url": "/",
      "description": "This server"
    }
  ],
  "tags": [
    {
      "name": "Databases",
      "description": "Database discovery and properties"
    },
    {
      "name": "Design",
      "description": "Views and forms"
    },
    {
      "name": "DXL",
      "description": "DXL export and import"
    },
    {
      "name": "Documents",
      "description": "Document, named document and profile document items"
    },
    {
      "name": "Server",
      "description": "Server lifecycle"
    }
  ],
  "paths": {
    "/api/databases": {
      "get": {
        "tags": [
          "Databases"
        ],
        "summary": "List databases on a server",
        "description": "Lists the databases visible to the current identity. Recursive by default: Domino's directory search is flat unless recursion is requested, which silently hides everything in subdirectories.",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "name": "recursive",
            "in": "query",
            "description": "Descend into subdirectories. Pass `false` for a flat listing of the data directory root only.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The databases found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "server": {
                      "type": "string",
                      "example": "(local)"
                    },
                    "recursive": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "databases": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DatabaseEntry"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/database": {
      "get": {
        "tags": [
          "Databases"
        ],
        "summary": "Database details",
        "description": "Properties of a single database. Individual properties are best-effort: some are unavailable depending on the database and on the rights of the current identity, and are returned as null rather than failing the request.",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          }
        ],
        "responses": {
          "200": {
            "description": "Database properties",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseDetails"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/database/views": {
      "get": {
        "tags": [
          "Design"
        ],
        "summary": "List the views of a database",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          }
        ],
        "responses": {
          "200": {
            "description": "The views defined in the database design",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "views": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ViewSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/database/forms": {
      "get": {
        "tags": [
          "Design"
        ],
        "summary": "List the forms of a database",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          }
        ],
        "responses": {
          "200": {
            "description": "The forms defined in the database design",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "forms": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FormSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/database/form": {
      "get": {
        "tags": [
          "Design"
        ],
        "summary": "Full design of a single form",
        "description": "Everything the design holds about one form: its field definitions with data types, kinds and formulas, plus the form's own properties, formulas, events, subform references and LotusScript.\n\nThe form may be addressed by its title or by any of its aliases.",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          },
          {
            "name": "form",
            "in": "query",
            "description": "Form title or alias.",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Person"
          }
        ],
        "responses": {
          "200": {
            "description": "The form design",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormDetails"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/document": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Items of a document, by note ID or UNID",
        "description": "Exactly one of `noteid` or `unid` must be given. Note IDs are hexadecimal and may carry an `NT` or `0x` prefix.",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          },
          {
            "name": "noteid",
            "in": "query",
            "description": "Hexadecimal note ID, e.g. `8FA` or `NT000008FA`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "unid",
            "in": "query",
            "description": "32-character universal ID. Takes precedence over `noteid`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The document and its items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDump"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/documents/named": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "List the named documents of a database",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          }
        ],
        "responses": {
          "200": {
            "description": "The named documents that exist",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "namedDocuments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "userName": {
                            "type": "string"
                          },
                          "noteId": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/document/named": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Items of a named document",
        "description": "Returns 404 when the name does not exist. Note that the underlying API would otherwise return a new, unsaved document for a missing name; that case is reported as not found, which is the correct reading for a read-only API.",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          },
          {
            "name": "name",
            "in": "query",
            "description": "Name of the document.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/username"
          }
        ],
        "responses": {
          "200": {
            "description": "The named document and its items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDump"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/document/profile": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Items of a profile document",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          },
          {
            "name": "profile",
            "in": "query",
            "description": "Profile name, e.g. `calendarprofile`.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/username"
          }
        ],
        "responses": {
          "200": {
            "description": "The profile document and its items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDump"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/shutdown": {
      "post": {
        "tags": [
          "Server"
        ],
        "summary": "Stop the server and the runner",
        "description": "Performs an orderly shutdown: HTTP server first, then the Domino worker threads, then the Domino runtime.\n\nThis exists because the Notes runtime installs native signal handlers that swallow SIGINT and SIGTERM, so Ctrl+C cannot stop the process and SIGKILL would skip all cleanup.",
        "responses": {
          "202": {
            "description": "Shutdown accepted and under way",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "The runner was not started with --wait, so there is nothing to stop"
          }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "tags": [
          "Server"
        ],
        "summary": "What this server allows",
        "description": "Reports whether writing is enabled, so a client can disable destructive controls instead of guessing.",
        "responses": {
          "200": {
            "description": "Capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "writeAllowed": {
                      "type": "boolean"
                    },
                    "importOptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/database/design": {
      "get": {
        "tags": [
          "Design"
        ],
        "summary": "Every design element of a database",
        "description": "Enumerates the complete design. Built in two passes: types JNX can model are requested one at a time (a single unsupported kind would otherwise fail the whole listing), then the raw design collection supplies anything those passes missed, reported with type `Other`.",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Return only this type, e.g. `Form`, `View`, `Other`."
          },
          {
            "name": "signatures",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Include signer and signed state. Off by default: it opens every design note."
          }
        ],
        "responses": {
          "200": {
            "description": "The design elements",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "modelledByJnx": {
                      "type": "integer"
                    },
                    "other": {
                      "type": "integer"
                    },
                    "byType": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "skippedTypes": {
                      "type": "object",
                      "description": "Types that could not be read, and why",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "elements": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DesignElementSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/dxl/export": {
      "get": {
        "tags": [
          "DXL"
        ],
        "summary": "DXL of one note",
        "description": "Exports a single note — design element or document, which at this level are the same thing.",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          },
          {
            "name": "noteid",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Hexadecimal note ID."
          },
          {
            "name": "unid",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Universal ID. Takes precedence over noteid."
          },
          {
            "name": "omitAttachments",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Leave rich text attachments out of the DXL."
          },
          {
            "name": "omitPictures",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Leave pictures out."
          },
          {
            "name": "omitOle",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Leave OLE objects out."
          },
          {
            "name": "forceNoteFormat",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Export raw note format instead of the semantic form."
          },
          {
            "name": "download",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Send Content-Disposition so the browser saves the file."
          }
        ],
        "responses": {
          "200": {
            "description": "DXL document",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
