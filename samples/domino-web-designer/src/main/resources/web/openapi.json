          },
          {
            "name": "omitPictures",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Leave pictures out."
          },
          {
            "name": "omitOle",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Leave OLE objects out."
          },
          {
            "name": "forceNoteFormat",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Export raw note format instead of the semantic form."
          },
          {
            "name": "download",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Send Content-Disposition so the browser saves the file."
          }
        ],
        "responses": {
          "200": {
            "description": "DXL document",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/dxl/export/database": {
      "get": {
        "tags": [
          "DXL"
        ],
        "summary": "DXL of a whole database, its design or its ACL",
        "description": "Streamed to the response rather than assembled in memory: a full database export can run to hundreds of megabytes.",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          },
          {
            "name": "what",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "design",
                "acl"
              ],
              "default": "all"
            }
          },
          {
            "name": "omitAttachments",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Leave rich text attachments out of the DXL."
          },
          {
            "name": "omitPictures",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Leave pictures out."
          },
          {
            "name": "omitOle",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Leave OLE objects out."
          },
          {
            "name": "forceNoteFormat",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Export raw note format instead of the semantic form."
          },
          {
            "name": "download",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Send Content-Disposition so the browser saves the file."
          }
        ],
        "responses": {
          "200": {
            "description": "DXL document",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/dxl/import": {
      "post": {
        "tags": [
          "DXL"
        ],
        "summary": "Import DXL into a database",
        "description": "Writes to the database. Requires `--allow-write`, and is a **dry run unless `confirm=true`** — the dry run reports what the DXL contains without touching anything.\n\nBefore a real import the current design is exported to a backup file, whose path is returned; if the backup cannot be written the import is not attempted.\n\nTwo behaviours worth knowing: the DOCTYPE declaration is stripped from the DXL, because the DTD it points at cannot be resolved and would fail the import; and `replicaRequired` is false by default, since Domino would otherwise refuse to replace notes unless the DXL came from a replica of the target.\n\nThe operation is not transactional: notes are written before signing runs, so a signing failure is reported per note in `signErrors` alongside what did succeed.",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          },
          {
            "name": "confirm",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Actually write. Without it, nothing is changed."
          },
          {
            "name": "sign",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Sign the imported notes with the runner's identity."
          },
          {
            "name": "designOption",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "REPLACE_ELSE_CREATE"
            },
            "description": "How to treat design elements."
          },
          {
            "name": "documentOption",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "CREATE"
            },
            "description": "How to treat documents."
          },
          {
            "name": "replicaRequired",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Require DXL and database to be replicas before replacing."
          },
          {
            "name": "validate",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Validate against the DTD. Usually fails, as the DTD cannot be resolved."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dry-run report, or the result of the import",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dryRun": {
                      "type": "boolean"
                    },
                    "backup": {
                      "type": "string"
                    },
                    "importedCount": {
                      "type": "integer"
                    },
                    "importedNoteIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "signedCount": {
                      "type": "integer"
                    },
                    "signedBy": {
                      "type": "string"
                    },
                    "signErrors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "log": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "description": "The server was started without --allow-write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/dxl/sign": {
      "post": {
        "tags": [
          "DXL"
        ],
        "summary": "Sign an existing note",
        "description": "Applies the runner's identity to one note. Requires `--allow-write`.\n\nSigning goes through the classic Notes API: JNX's own `Document.sign()` fails on design notes with \"inconsistent field signatures\".",
        "parameters": [
          {
            "$ref": "#/components/parameters/server"
          },
          {
            "$ref": "#/components/parameters/db"
          },
          {
            "name": "noteid",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "unid",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The signed note",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "noteId": {
                      "type": "string"
                    },
                    "unid": {
                      "type": "string"
                    },
                    "signer": {
                      "type": "string"
                    },
                    "signed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The server was started without --allow-write"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "server": {
        "name": "server",
        "in": "query",
        "description": "Domino server name. Leave empty for the local data directory.",
        "required": false,
        "schema": {
          "type": "string",
          "default": ""
        },
        "example": ""
      },
      "db": {
        "name": "db",
        "in": "query",
        "description": "Database file path (may include subdirectories) or replica ID.",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "names.nsf"
      },
      "username": {
        "name": "username",
        "in": "query",
        "description": "User name to scope the lookup to. Optional.",
        "required": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "A required parameter is missing or malformed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The database, document or design element does not exist",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error": {
        "description": "Unexpected failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
